# Stage 1: Install dependencies
FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Stage 2: Build the application
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Sub-path deployments: empty serves the app from the domain root.
ARG NEXT_PUBLIC_BASE_PATH=
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm build

# Stage 3: Production runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Refuses to start when NEXT_PUBLIC_BASE_PATH disagrees with the base path this
# image was built for. Next fixes the base path at build time, so a published
# root-path image given a sub-path would otherwise start and serve broken links.
# A plain COPY and a chmod, not COPY --chmod, so legacy (non-BuildKit) builds work.
COPY docker-entrypoint.sh /usr/local/bin/ff-web-entrypoint
RUN chmod 0755 /usr/local/bin/ff-web-entrypoint

USER nextjs

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/ff-web-entrypoint"]
CMD ["node", "server.js"]
